# ── Application ──────────────────────────────────────────────────────────
APP_NAME=Marrow
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generate with: php forge key:generate
APP_KEY=

# ── Database ─────────────────────────────────────────────────────────────
# Drivers: sqlite | mysql | pgsql
DB_DRIVER=sqlite
DB_DATABASE=storage/database.sqlite
# For mysql/pgsql, also set:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Cache ────────────────────────────────────────────────────────────────
# Drivers: file | apcu | redis | array
CACHE_DRIVER=file
# REDIS_DSN=redis://127.0.0.1:6379

# ── Auth ─────────────────────────────────────────────────────────────────
AUTH_GUARD=session
# Required if the `jwt` guard is used — must be at least 32 characters.
JWT_SECRET=
JWT_TTL=3600

# ── RBAC ─────────────────────────────────────────────────────────────────
RBAC_SUPER_ADMIN_ROLE=admin

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Mail ─────────────────────────────────────────────────────────────────
# See https://symfony.com/doc/current/mailer.html#using-built-in-transports
MAIL_DSN=null://null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Filesystem ───────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Queue ────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
