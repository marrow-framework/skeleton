<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ config('app.name') }}{% endblock %}</title>

    {# Vite dev server (HMR) vs. built production assets — see
       Marrow\Template\FrameworkExtension::funcViteDevMode()/funcViteAsset()/
       funcViteClient() and docs/frontend.md. A CSS entry needs a <script
       type="module"> in dev (Vite serves it as a hot-reloadable JS module)
       but a real <link rel="stylesheet"> once built. #}
    {% if vite_dev_mode() %}
        {{ vite_client()|raw }}
        <script type="module" src="{{ vite_asset('resources/css/app.css') }}"></script>
        <script type="module" src="{{ vite_asset('resources/js/app.js') }}"></script>
    {% else %}
        <link rel="stylesheet" href="{{ vite_asset('resources/css/app.css') }}">
        <script type="module" src="{{ vite_asset('resources/js/app.js') }}" defer></script>
    {% endif %}

    {% block head %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
</body>
</html>
